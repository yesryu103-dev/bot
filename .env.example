TELEGRAM_BOT_TOKEN=123456:replace_me
# Telegram chat/group ID that may use the bot. Comma-separated for multiple chats.
# Private chat IDs are positive numbers. Group/supergroup IDs start with -100.
TELEGRAM_CHAT_ID=-1001234567890
BOT_TITLE=Treasure_tradingbot
BOT_TAGLINE=
# Social links removed from main panel (leave empty).
PROJECT_TELEGRAM_URL=
PROJECT_TWITTER_URL=
PROJECT_WEBSITE_URL=

# Chain: robinhood (Uniswap) | bsc (PancakeSwap V3). Aliases: pancake, pancakeswap, bnb.
CHAIN=robinhood
# For PancakeSwap on BSC set:
# CHAIN=bsc
# RPC_URL=https://bsc-rpc.publicnode.com
# RPC_WS_URL=wss://bsc-rpc.publicnode.com
# STATE_FILE=state.bsc.json
# Then paste https://dexscreener.com/bsc/<pair> or a token contract.

# Robinhood REPE/WETH Uniswap v3 pair from Dexscreener (ignored defaults when CHAIN=bsc):
PAIR_ADDRESS=0xb541c2936982dd5c4090783d8f395d3e613c8016
BASE_TOKEN_ADDRESS=0x5266eeaff092d6136ab63d18b975a60a0cc0c8f7
QUOTE_TOKEN_ADDRESS=0x0bd7d308f8e1639fab988df18a8011f41eacad73
BASE_SYMBOL=REPE
QUOTE_SYMBOL=WETH

POLL_SECONDS=3
MAX_ITEMS=200
MIN_USD=0
MIN_QUOTE_AMOUNT=1
# Only alert swaps newer than this many ms (realtime). Older txs are ignored.
MAX_ALERT_AGE_MS=90000
# HTTP catch-up window in ms (Robinhood ~0.1s/block — do NOT use tiny block lookbacks).
RPC_SWAP_LOOKBACK_MS=180000
# Optional hard block override (0 = derive from RPC_SWAP_LOOKBACK_MS). Old default 100 was ~10s on RH.
# RPC_SWAP_LOOKBACK_BLOCKS=0
# eth_getLogs chunk size. Alchemy free max 10; publicnode ok at 100+.
RPC_GETLOGS_MAX_BLOCK_RANGE=100
DRY_RUN=0
BACKFILL_ON_START=0
FETCH_TX_DETAILS=0

# Default 1 means base token out of pool = BUY, base token into pool = SELL.
BUY_WHEN_BASE_LEAVES_POOL=1

# Telegram trade buttons (one tap = send tx).
BUY_AMOUNTS_QUOTE=0.01,0.05,0.1,0.2,0.25
SELL_PERCENTS=25,50,70

# Keep disabled until you configure a trading wallet.
TRADE_ENABLED=0
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional: WebSocket for near-realtime Swap alerts.
# Primary first; comma-separated list OR set RPC_WS_URL_FALLBACK.
# Example: RPC_WS_URL=wss://robinhood.api.pocket.network
#          RPC_WS_URL_FALLBACK=wss://robinhood-rpc.publicnode.com
RPC_WS_URL=
RPC_WS_URL_FALLBACK=
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
SWAP_ROUTER_ADDRESS=0xCaf681a66D020601342297493863E78C959E5cb2
QUOTER_ADDRESS=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
UNISWAP_V3_FEE=10000
SLIPPAGE_BPS=200

# Gas for trade txs (Robinhood is cheap; raise bump/tip if inclusion feels slow).
# gasLimit = estimate * (1 + BUFFER/10000). 3000 = +30%.
GAS_LIMIT_BUFFER_BPS=3000
# maxFee/gasPrice bump over network. 2000 = +20% (max 5000 = +50%).
GAS_FEE_BUMP_BPS=2000
# Priority tip floor in gwei (used when network tip is 0).
GAS_PRIORITY_GWEI=0.001
# ETH reserved for gas (not spent on swap value).
GAS_RESERVE_ETH=0.0001

# Portfolio: hide tokens below these USD thresholds.
MIN_PORTFOLIO_LIQUIDITY_USD=50
MIN_PORTFOLIO_VALUE_USD=3
PORTFOLIO_MAX_TOKENS=25
